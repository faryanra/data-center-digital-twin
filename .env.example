# Copy to .env.local — never commit .env.local

# ── Frontend ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/facility

# JWT signing secret — must be ≥ 32 random characters in production
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins for the FastAPI backend
CORS_ORIGINS=http://localhost:3000

# ── Database (PostgreSQL recommended for production) ──────────────────────────
DATABASE_URL=postgresql+asyncpg://dc:dc@localhost:5432/dc
# SQLite (local dev only): DATABASE_URL=sqlite+aiosqlite:///./dc_digital_twin.db

POSTGRES_USER=dc
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dc

# ── MQTT ──────────────────────────────────────────────────────────────────────
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_HOST=localhost
MQTT_PORT=1883

# ── Modbus ────────────────────────────────────────────────────────────────────
MODBUS_PORT=5020

# ── InfluxDB (optional — historical telemetry charts) ─────────────────────────
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=CHANGE_ME
INFLUXDB_ORG=dc-north-01
INFLUXDB_BUCKET=telemetry

# ── SNMP (physical hardware — APC/Eaton/Schneider UPS/PDU) ───────────────────
# Format: JSON array of device descriptors
# SNMP_DEVICES_JSON='[{"host":"192.168.1.100","community":"public","type":"ups","id":"ups-01"}]'
SNMP_DEVICES_JSON=[]

# ── API key (optional — protects legacy /api/* endpoints) ─────────────────────
API_KEY=CHANGE_ME

# ── AWS (Terraform only) ──────────────────────────────────────────────────────
# AWS_REGION=eu-north-1
