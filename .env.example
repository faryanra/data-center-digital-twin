# Copy to .env (Docker / backend) — never commit the real file.
# The frontend reads apps/web/.env.local (see apps/web/.env.local.example).

# ── Auth ───────────────────────────────────────────────────────────────────────
# Signs the session cookie in Next.js and verifies it in FastAPI, so the
# frontend and the backend MUST use the same value. ≥ 32 random characters:
#   openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the FastAPI backend directly.
CORS_ORIGINS=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Omit DATABASE_URL to use the local SQLite fallback.
DATABASE_URL=postgresql+asyncpg://dc:dc@localhost:5432/dc
POSTGRES_USER=dc
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=dc

# ── MQTT (optional — snapshot publish) ────────────────────────────────────────
MQTT_HOST=localhost
MQTT_PORT=1883

# ── Modbus TCP ────────────────────────────────────────────────────────────────
# Loopback by default; Docker sets MODBUS_HOST=0.0.0.0 so the port is reachable.
MODBUS_HOST=127.0.0.1
MODBUS_PORT=5020

# ── SNMP (physical hardware — APC/Eaton/Schneider UPS/PDU) ───────────────────
# JSON array of device descriptors, e.g.
# SNMP_DEVICES_JSON='[{"host":"192.168.1.100","community":"public","type":"ups","id":"ups-01"}]'
SNMP_DEVICES_JSON=[]

# ── API key (optional) ────────────────────────────────────────────────────────
# When set, the /api/* device endpoints and fault injection also require X-API-Key.
API_KEY=

# ── Grafana ───────────────────────────────────────────────────────────────────
GRAFANA_PASSWORD=admin
