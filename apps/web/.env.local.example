# Copy to apps/web/.env.local — never commit the real file.

# Browser → FastAPI WebSocket for live facility snapshots (wss:// in production).
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/facility

# Server-side proxy (/api/proxy/*) → FastAPI base URL.
API_BASE_URL=http://localhost:8000

# Signs the session cookie. Must equal the backend's JWT_SECRET, because FastAPI
# verifies the same token. Leave unset in local dev to use the shared dev default.
# JWT_SECRET=

# Only needed if the backend sets API_KEY.
# API_KEY=
