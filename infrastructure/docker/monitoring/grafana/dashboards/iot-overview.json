{
  "__inputs": [],
  "__requires": [
    {"type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.4.2"},
    {"type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0"}
  ],
  "annotations": {"list": []},
  "description": "IoT Platform Overview — devices, alerts, telemetry, power, and API metrics",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "Devices Online",
      "gridPos": {"h": 6, "w": 4, "x": 0, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 1},
            {"color": "green", "value": 3}
          ]},
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true},
      "targets": [{"expr": "iot_devices_online_total", "legendFormat": "Online", "refId": "A"}]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Devices Offline",
      "gridPos": {"h": 6, "w": 4, "x": 4, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "red", "value": 1}
          ]},
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "targets": [{"expr": "iot_devices_offline_total", "legendFormat": "Offline", "refId": "A"}]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active Alerts",
      "gridPos": {"h": 6, "w": 4, "x": 8, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "green", "value": null},
            {"color": "orange", "value": 1},
            {"color": "red", "value": 5}
          ]},
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {"reduceOptions": {"calcs": ["lastNotNull"]}, "orientation": "auto", "textMode": "auto", "colorMode": "background"},
      "targets": [{"expr": "sum(iot_alerts_active_total)", "legendFormat": "Active", "refId": "A"}]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "MQTT Message Rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "rate(iot_mqtt_messages_total[1m])", "legendFormat": "{{device_id}}", "refId": "A"}]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Power Consumption (W)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "watt", "color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "iot_power_consumption_watts", "legendFormat": "{{device_id}}", "refId": "A"}]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Energy Accumulated (kWh)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "kwatth", "color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "iot_energy_kwh_total", "legendFormat": "{{device_id}}", "refId": "A"}]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Temperature (°C)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "celsius", "color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "iot_temperature_celsius", "legendFormat": "{{device_id}}", "refId": "A"}]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Voltage (V)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "volt", "color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "iot_voltage_volts", "legendFormat": "{{device_id}}", "refId": "A"}]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "API Request Rate",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "rate(http_requests_total[1m])", "legendFormat": "{{handler}} {{method}}", "refId": "A"}]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Telemetry Ingestion Rate",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {"unit": "reqps", "color": {"mode": "palette-classic"}},
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "rate(iot_telemetry_readings_total[1m])", "legendFormat": "{{metric_type}} / {{device_id}}", "refId": "A"}]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Power Factor",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "color": {"mode": "thresholds"},
          "thresholds": {"mode": "absolute", "steps": [
            {"color": "red", "value": null},
            {"color": "yellow", "value": 0.8},
            {"color": "green", "value": 0.9}
          ]},
          "custom": {"lineWidth": 2}
        },
        "overrides": []
      },
      "options": {"tooltip": {"mode": "multi"}, "legend": {"displayMode": "list", "placement": "bottom"}},
      "targets": [{"expr": "iot_power_factor", "legendFormat": "{{device_id}}", "refId": "A"}]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Grid Frequency (Hz)",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {
        "defaults": {
          "unit": "hertz",
          "min": 49,
          "max": 51,
          "color": {"mode": "palette-classic"},
          "custom": {"lineWidth": 2}
        },
        "overrides": []
      },
      "options": {
        "tooltip": {"mode": "multi"},
        "legend": {"displayMode": "list", "placement": "bottom"}
      },
      "targets": [{"expr": "iot_frequency_hz", "legendFormat": "{{device_id}}", "refId": "A"}]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 36,
  "tags": ["iot", "smarthome"],
  "templating": {"list": []},
  "time": {"from": "now-1h", "to": "now"},
  "timepicker": {},
  "timezone": "browser",
  "title": "IoT Platform Overview",
  "uid": "iot-overview",
  "version": 2
}
